{
  "openapi": "3.1.0",
  "info": {
    "title": "Gas Catalog App",
    "version": "0.1.0"
  },
  "paths": {
    "/api/gases": {
      "get": {
        "summary": "Получить список газов",
        "description": "Возвращает опубликованные газы. Поддерживает фильтрацию по названию через query-параметр search. Доступно гостю.",
        "operationId": "api_get_gases_api_gases_get",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Search"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GasListItem"
                  },
                  "title": "Response Api Get Gases Api Gases Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Создать газ",
        "description": "Создает газ в статусе draft и загружает изображение и видео в MinIO. creator_id берется из авторизованной cookie-сессии.",
        "operationId": "api_create_gas_api_gases_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_api_create_gas_api_gases_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GasDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/gases/feed": {
      "get": {
        "summary": "Получить газ для ленты",
        "description": "Возвращает опубликованный газ для ленты. Без параметров возвращает первый газ. С gas_id и next=true возвращает следующий опубликованный газ. Доступно гостю.",
        "operationId": "api_get_feed_api_gases_feed_get",
        "parameters": [
          {
            "name": "gas_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Gas Id"
            }
          },
          {
            "name": "next",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Next"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GasFeedItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/gases/draft": {
      "get": {
        "summary": "Получить черновик газа",
        "description": "Возвращает черновик текущего авторизованного пользователя. Требует cookie session_id.",
        "operationId": "api_get_draft_api_gases_draft_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GasDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/gases/{gas_id}/publish": {
      "put": {
        "summary": "Опубликовать газ",
        "description": "Публикует черновик текущего пользователя. Гость получает 401, чужой газ нельзя опубликовать.",
        "operationId": "api_publish_gas_api_gases__gas_id__publish_put",
        "parameters": [
          {
            "name": "gas_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Gas Id"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GasPublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GasActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/gases/{gas_id}": {
      "delete": {
        "summary": "Удалить газ",
        "description": "Выполняет soft delete газа текущего пользователя: статус меняется на deleted.",
        "operationId": "api_delete_gas_api_gases__gas_id__delete",
        "parameters": [
          {
            "name": "gas_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Gas Id"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
