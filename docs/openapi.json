    "/api/users/login": {
      "post": {
        "summary": "Аутентифицировать пользователя",
        "description": "Проверяет логин и пароль, создает сессию в Redis и отправляет session_id в cookie.",
        "operationId": "api_login_user_api_users_login_post",
        "requestBody": {
          "content": {
