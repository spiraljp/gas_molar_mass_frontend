    "/api/gases/{gas_id}/like": {
      "post": {
        "summary": "Поставить или убрать лайк",
        "description": "Ставит или убирает лайк от текущего авторизованного пользователя. value=1 ставит лайк, value=0 убирает.",
        "operationId": "api_set_like_api_gases__gas_id__like_post",
        "parameters": [
          {
            "name": "gas_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Gas Id"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
